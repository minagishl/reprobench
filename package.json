{
  "name": "reprobench",
  "version": "0.3.0",
  "description": "Reproducible benchmark runner powered by Nix flakes",
  "keywords": [
    "benchmark",
    "cli",
    "nix",
    "reproducible"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/minagishl/reprobench"
  },
  "bin": {
    "reprobench": "./dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "check": "pnpm lint && pnpm fmt:check && pnpm test && pnpm build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "execa": "^9.6.1",
    "picocolors": "^1.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "oxfmt": "latest",
    "oxlint": "latest",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
